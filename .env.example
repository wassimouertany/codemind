# ---------- app ----------
CODEMIND_ENV=dev
LOG_LEVEL=INFO

# ---------- qdrant ----------
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=codemind_chunks
# int8 scalar quantization: ~4x less RAM for vectors, ~1% recall loss
QDRANT_QUANTIZATION=true
QDRANT_ON_DISK=true

# ---------- storage ----------
REPOS_DIR=./.repos
GRAPH_DIR=./data/graphs
DATABASE_URL=sqlite+aiosqlite:///./data/codemind.db
CHECKPOINT_DB=./data/checkpoints.db

# ---------- models ----------
EMBEDDING_MODEL=jinaai/jina-embeddings-v2-base-code
EMBEDDING_DIM=768
# cuda during `make ingest`, cpu during `make dev`  <-- 4GB VRAM policy
EMBEDDING_DEVICE=cpu

RERANKER_MODEL=BAAI/bge-reranker-base
RERANKER_DEVICE=cpu
RERANKER_BATCH_SIZE=16
RERANKER_MAX_LENGTH=512

# ---------- llm ----------
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=qwen2.5-coder:3b-instruct-q4_K_M
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0.1
LLM_NUM_CTX=8192

# ---------- retrieval ----------
PREFETCH_DENSE=20
PREFETCH_SPARSE=20
# rrf: fuse ranks only (default) | dbsf: normalise scores per branch, keeps confidence margins
FUSION_METHOD=rrf
RERANK_TOP_K=5
# call-graph expansion around reranked hits; EXPANSION_DEPTH=0 disables it
EXPANSION_DEPTH=1
EXPANSION_MAX_EXTRA=10

# ---------- observability ----------
LANGFUSE_PUBLIC_KEY=pk-lf-xxxx
LANGFUSE_SECRET_KEY=sk-lf-xxxx
LANGFUSE_HOST=https://cloud.langfuse.com

# ---------- evaluation only ----------
JUDGE_MODEL=
JUDGE_API_KEY=
