{#
  Numbered code context shared by the specialist prompts. The numbers are the
  citation keys: the node maps [n] back to chunks[n-1]'s real path and lines,
  so they must start at 1 and follow the retriever's order exactly.
#}
{% macro numbered_chunks(chunks, show_imports=false) %}
{% for chunk in chunks %}
[{{ loop.index }}] {{ chunk.relative_path }}:{{ chunk.start_line }}-{{ chunk.end_line }}{% if chunk.context_header %} | {{ chunk.context_header }}{% endif %}

{% if show_imports and chunk.imports %}
imports: {{ chunk.imports | join(", ") }}
{% endif %}
```{{ chunk.language.value }}
{{ chunk.body }}
```

{% endfor %}
{% endmacro %}

{#
  Claims for the synthesizer, numbered [1]..[n]. These numbers are the only
  thing the answer may cite; locations stay with the claims.
#}
{% macro numbered_claims(claims) %}
{% for claim in claims %}
[{{ loop.index }}] {{ claim.claim }}
{% endfor %}
{% endmacro %}

{#
  The code the claims rest on, labelled by the claims that cite it and by path
  only — no line numbers, so the answer has none to copy into prose.
#}
{% macro cited_code(sources) %}
{% for source in sources %}
Code for {{ source.label }} — {{ source.chunk.relative_path }}
```{{ source.chunk.language.value }}
{{ source.chunk.body }}
```

{% endfor %}
{% endmacro %}
