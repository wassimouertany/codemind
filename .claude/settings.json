{
  "permissions": {
    "allow": [
      "Bash(uv run:*)",
      "Bash(uv sync:*)",
      "Bash(make:*)",
      "Bash(docker compose:*)",
      "Bash(pytest:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "uv run ruff check --fix src tests 2>&1 | tail -5; uv run ruff format src tests >/dev/null 2>&1 || true"
          }
        ]
      }
    ]
  }
}
